# Dependencies
node_modules/

# Build output — packaged Electron runtimes are reproducible from src + lockfile
# `release*/` used to sit here, and a bare pattern matches at every depth: it also hid
# poolside/docs/release-evidence/, so a document the work-item register requires was never in git.
# `release/` hides the packaged output this rule is for and nothing else.
release/
poolside-builds/
*.asar

# Logs and local agent state
*.log
.env
.env.*

# OS / editor
Thumbs.db
.DS_Store

# Mercury agent runtime remnants
mercury-*

# Local one-off maintenance scripts
.edit_release.cjs)
