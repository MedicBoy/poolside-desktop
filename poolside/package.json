{
  "name": "poolside",
  "version": "0.1.0",
  "private": true,
  "description": "Local desktop workspace for isolated 8 Ball Pool account sessions",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{cjs,js,css,html}\" \"test/**/*.cjs\" \"*.md\"",
    "format:check": "prettier --check \"src/**/*.{cjs,js,css,html}\" \"test/**/*.cjs\" \"*.md\"",
    "typecheck": "tsc --noEmit",
    "verify": "npm run lint && npm run typecheck && npm test",
    "test": "node --test test/*.test.cjs",
    "test:desktop": "electron . --self-test",
    "test:persistence": "node test/run-session-restart.cjs",
    "test:game": "electron . --game-check",
    "package": "electron-packager . Poolside --platform=win32 --arch=x64 --out=release --asar.unpackDir=node_modules --overwrite --ignore=^/release --ignore=^/test"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@types/node": "^26.6.1",
    "electron": "44.4.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.8",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "1.0.0",
    "sharp": "0.35.4",
    "tesseract.js": "7.0.0"
  }
}
