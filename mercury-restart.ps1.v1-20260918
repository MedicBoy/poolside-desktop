<#
  mercury-restart.ps1
  ------------------------------------------------------------------
  Purpose : cleanly restart the Mercury node runtime so the freshly
            patched dist/index.js is loaded by BOTH the foreground
            instance and the background daemon.

  Why Task Scheduler: this script is launched by Windows Task Scheduler,
            NOT by the agent. That way it survives killing the very
            process tree it is restarting (the foreground agent hosts
            the tool shell, so an in-process restart would die midway).

  Sequence: patch sanity -> grace delay -> stop foreground -> stop daemon
            -> sweep strays -> clear stale pid files -> start daemon
            -> verify pid + IPC port + Telegram socket -> verdict

  Author  : PiePeP (for Nick)
  Written : 2026-09-18
#>

param(
  [int]$GraceSeconds = 60
)

$ErrorActionPreference = 'Continue'
$ProgressPreference    = 'SilentlyContinue'

# --- configuration -------------------------------------------------
$MercuryHome = 'C:\Users\nicho\.mercury'
$NodeExe     = 'C:\Users\nicho\AppData\Local\hermes\node\node.exe'
$EntryJs     = 'C:\Users\nicho\AppData\Local\hermes\node\node_modules\@cosmicstack\mercury-agent\dist\index.js'
$MercuryCmd  = 'C:\Users\nicho\AppData\Local\hermes\node\mercury.cmd'
$HermesCwd   = 'C:\Users\nicho\AppData\Local\hermes'
$IpcPort     = 6174
$Stamp       = Get-Date -Format 'yyyyMMdd-HHmmss'
$LogFile     = Join-Path $MercuryHome ('restart-' + $Stamp + '.log')

# --- helpers -------------------------------------------------------
function Write-Log {
  param([string]$Message)
  $line = (Get-Date -Format 'yyyy-MM-dd HH:mm:ss') + '  ' + $Message
  Add-Content -Path $LogFile -Value $line -Encoding UTF8
}

function Get-TrackedPid {
  param([string]$FileName)
  $p = Join-Path $MercuryHome $FileName
  if (-not (Test-Path $p)) { return $null }
  $raw = Get-Content $p -Raw -ErrorAction SilentlyContinue
  if ($null -eq $raw) { return $null }
  $raw = $raw.Trim()
  $n = 0
  if ([int]::TryParse($raw, [ref]$n)) { return $n }
  return $null
}

function Test-PidAlive {
  param($ProcessId)
  if ($null -eq $ProcessId) { return $false }
  $proc = Get-Process -Id $ProcessId -ErrorAction SilentlyContinue
  if ($null -eq $proc) { return $false }
  return $true
}

function Test-IpcPort {
  $conn = Get-NetTCPConnection -State Listen -LocalPort $IpcPort -ErrorAction SilentlyContinue
  if ($null -eq $conn) { return $false }
  return $true
}

function Test-TelegramSocket {
  $conn = Get-NetTCPConnection -ErrorAction SilentlyContinue |
          Where-Object { $_.RemoteAddress -like '149.154.*' -and $_.RemotePort -eq 443 }
  if ($null -eq $conn) { return $false }
  return $true
}

function Stop-TrackedPid {
  param($ProcessId, [string]$Label)
  if (-not (Test-PidAlive $ProcessId)) {
    Write-Log ('SKIP    ' + $Label + ' pid ' + $ProcessId + ' not running')
    return
  }
  Write-Log ('STOP    ' + $Label + ' pid ' + $ProcessId + ' (graceful)')
  try { Stop-Process -Id $ProcessId -ErrorAction Stop } catch {
    Write-Log ('WARN    graceful stop threw: ' + $_.Exception.Message)
  }
  $deadline = (Get-Date).AddSeconds(5)
  while ((Get-Date) -lt $deadline -and (Test-PidAlive $ProcessId)) {
    Start-Sleep -Milliseconds 250
  }
  if (Test-PidAlive $ProcessId) {
    Write-Log ('FORCE   ' + $Label + ' pid ' + $ProcessId + ' (hard kill)')
    Stop-Process -Id $ProcessId -Force -ErrorAction SilentlyContinue
    Start-Sleep -Milliseconds 750
  }
  if (Test-PidAlive $ProcessId) {
    Write-Log ('FAIL    ' + $Label + ' pid ' + $ProcessId + ' survived')
  } else {
    Write-Log ('OK      ' + $Label + ' pid ' + $ProcessId + ' stopped')
  }
}

# --- begin ---------------------------------------------------------
Write-Log '============================================================'
Write-Log ('mercury-restart BEGIN  grace=' + $GraceSeconds + 's')
Write-Log ('entry   = ' + $EntryJs)
Write-Log ('exists  = ' + (Test-Path $EntryJs))

# 1. patch sanity - never restart into an unpatched bundle
if (-not (Test-Path $EntryJs)) {
  Write-Log 'ABORT   entry script missing'
  exit 2
}
$patchCount  = (Select-String -Path $EntryJs -SimpleMatch -Pattern 'type: "disabled"' -ErrorAction SilentlyContinue | Measure-Object).Count
$redactCount = (Select-String -Path $EntryJs -SimpleMatch -Pattern 'redactEnvBackedSecrets' -ErrorAction SilentlyContinue | Measure-Object).Count
Write-Log ('patch   thinking:disabled x' + $patchCount + '   redactEnvBackedSecrets x' + $redactCount)
if ($patchCount -lt 2 -or $redactCount -lt 2) {
  Write-Log 'ABORT   patch markers missing - refusing to restart into unpatched bundle'
  exit 2
}
Write-Log 'patch   verified (2/2 thinking sites + redaction present)'

# 2. grace delay so the agent can flush the "restarting now" message
if ($GraceSeconds -gt 0) {
  Write-Log ('WAIT    grace period ' + $GraceSeconds + 's')
  Start-Sleep -Seconds $GraceSeconds
}

# 3. stop both runtimes
$fgPid = Get-TrackedPid 'foreground.pid'
$dPid  = Get-TrackedPid 'daemon.pid'
Write-Log ('pids    foreground=' + $fgPid + '  daemon=' + $dPid)
Stop-TrackedPid -ProcessId $fgPid -Label 'foreground'
Stop-TrackedPid -ProcessId $dPid  -Label 'daemon'

# 4. sweep strays (any node.exe still holding the mercury bundle)
$strays = Get-CimInstance Win32_Process -Filter "Name='node.exe'" -ErrorAction SilentlyContinue |
          Where-Object { $_.CommandLine -like '*mercury-agent*' }
foreach ($s in $strays) {
  Write-Log ('SWEEP   stray mercury node pid ' + $s.ProcessId)
  Stop-Process -Id $s.ProcessId -Force -ErrorAction SilentlyContinue
}
Start-Sleep -Seconds 2

# 5. clear stale pid files
foreach ($f in @('daemon.pid', 'foreground.pid')) {
  $p = Join-Path $MercuryHome $f
  if (Test-Path $p) {
    Remove-Item $p -Force -ErrorAction SilentlyContinue
    Write-Log ('CLEAN   removed stale ' + $f)
  }
}

# 6. start the daemon
$env:MERCURY_HOME = $MercuryHome
$started = $false
Write-Log 'START   launching daemon via mercury.cmd start'
try {
  Start-Process -FilePath $MercuryCmd -WorkingDirectory $HermesCwd -WindowStyle Hidden -ErrorAction Stop | Out-Null
} catch {
  Write-Log ('WARN    mercury.cmd start threw: ' + $_.Exception.Message)
}

$newPid = $null
$deadline = (Get-Date).AddSeconds(45)
while ((Get-Date) -lt $deadline) {
  $newPid = Get-TrackedPid 'daemon.pid'
  if ((Test-PidAlive $newPid) -and (Test-IpcPort)) { $started = $true; break }
  Start-Sleep -Seconds 2
}

# 7. fallback: spawn the daemon directly (detached) using argv[1] semantics
if (-not $started) {
  Write-Log 'FALLBACK direct detached spawn of node daemon'
  $outLog = Join-Path $MercuryHome 'daemon.log'
  $errLog = Join-Path $MercuryHome 'daemon-error.log'
  Start-Process -FilePath $NodeExe `
                -ArgumentList @($EntryJs, 'start', '--daemon') `
                -WorkingDirectory $HermesCwd `
                -WindowStyle Hidden `
                -RedirectStandardOutput $outLog `
                -RedirectStandardError $errLog `
                -ErrorAction SilentlyContinue | Out-Null
  $deadline = (Get-Date).AddSeconds(45)
  while ((Get-Date) -lt $deadline) {
    $newPid = Get-TrackedPid 'daemon.pid'
    if ((Test-PidAlive $newPid) -and (Test-IpcPort)) { $started = $true; break }
    Start-Sleep -Seconds 2
  }
}

$daemonAlive = Test-PidAlive $newPid
$portUp      = Test-IpcPort
Write-Log ('verify  daemon pid=' + $newPid + ' alive=' + $daemonAlive + '  ipc' + $IpcPort + '=' + $portUp)

# 8. wait for the daemon to claim Telegram
$tgUp = $false
$deadline = (Get-Date).AddSeconds(60)
while ((Get-Date) -lt $deadline) {
  if (Test-TelegramSocket) { $tgUp = $true; break }
  Start-Sleep -Seconds 3
}
Write-Log ('verify  telegram socket = ' + $tgUp)

# 9. verdict
if ($started -and $tgUp) {
  Write-Log 'RESULT  HEALTHY - patched daemon up, IPC listening, Telegram connected'
} elseif ($started) {
  Write-Log 'RESULT  DAEMON-UP-TELEGRAM-PENDING - daemon alive but no Telegram socket yet'
} else {
  Write-Log 'RESULT  FAILED - daemon did not come up (see daemon.log / daemon-error.log)'
}
Write-Log ('logfile = ' + $LogFile)
Write-Log 'mercury-restart END'
Write-Log '============================================================'

# 10. self-remove the one-shot task so it never re-fires
try { schtasks /delete /tn 'MercuryRestartOnce' /f | Out-Null } catch { }
